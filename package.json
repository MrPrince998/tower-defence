{
  "name": "maze-defense",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/simulation",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w @maze/server\" \"npm run dev -w @maze/client\"",
    "db:start": "npm run db:start -w @maze/server",
    "db:migrate": "npm run db:migrate -w @maze/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run typecheck && npm run build -w @maze/server && npm run build -w @maze/client",
    "balance": "npm run balance -w @maze/simulation",
    "loadtest": "tsx tools/load-test.ts"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
